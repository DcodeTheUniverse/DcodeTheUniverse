{
  "name": "bluff-club",
  "private": true,
  "version": "0.1.0",
  "description": "Bluff Club — an offline-first, pass-the-phone party game. Everyone knows. Someone's pretending.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-build-mode.ts && tsc -p tsconfig.json --noEmit && vite build",
    "build:demo": "vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "content:validate": "node scripts/validate-content.ts",
    "android:assets": "node scripts/generate-android-assets.ts",
    "android:sync": "pnpm build && cap sync android",
    "android:open": "cap open android",
    "android:debug-apk": "pnpm android:sync && cd android && ./gradlew assembleDebug",
    "release:check": "node scripts/release-check.ts",
    "screenshots": "node scripts/capture-screenshots.ts"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@revenuecat/purchases-capacitor": "13.7.3",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@capacitor/cli": "8.5.3",
    "@playwright/test": "1.63.0",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.4",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.3"
  }
}
