# Copy to .env.local (never commit real values). Only PUBLIC client values belong here:
# everything prefixed VITE_ is compiled into the app bundle and visible to anyone.
# NEVER put Google service-account JSON, RevenueCat secret (sk_) keys, signing passwords
# or any private token in this file.

# RevenueCat *public* Android SDK key (starts with "goog_"). Leave blank to build without billing.
VITE_REVENUECAT_ANDROID_API_KEY=

# Support route shown in Settings (release blocker if blank in a production build).
VITE_SUPPORT_EMAIL=

# Hosted privacy-policy URL (release blocker if blank in a production build).
VITE_PRIVACY_POLICY_URL=

# Development/test only. Must be blank/false for production builds — the build refuses otherwise.
VITE_ENABLE_MOCK_BILLING=false
