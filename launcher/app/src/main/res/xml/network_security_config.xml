<?xml version="1.0" encoding="utf-8"?>
<!--
  Cloud providers are always called over HTTPS (their URLs are fixed in code). Cleartext is permitted
  only so a local model runtime the user configures on this phone or their LAN (e.g. http://192.168.1.20:11434)
  can be reached; the settings screen warns when such a URL is unencrypted.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
